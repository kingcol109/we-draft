{
  "rewrites": [
    { "source": "/draftsim", "destination": "/draftsim.html" },
    { "source": "/draftsim/:year(2028)", "destination": "/draftsim/:year.html" },
    { "source": "/draftsim/:team(ari|atl|bal|buf|car|chi|cin|cle|dal|den|det|gb|hou|ind|jax|kc|lac|lar|lv|mia|min|ne|no|nyg|nyj|phi|pit|sea|sf|tb|ten|was)", "destination": "/draftsim/:team.html" },
    { "source": "/draftsim/:year(2028)/:team(ari|atl|bal|buf|car|chi|cin|cle|dal|den|det|gb|hou|ind|jax|kc|lac|lar|lv|mia|min|ne|no|nyg|nyj|phi|pit|sea|sf|tb|ten|was)", "destination": "/draftsim/:year/:team.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/live-ingest", "schedule": "* * * * *" },
    { "path": "/api/stream-orchestrator", "schedule": "* * * * *" },
    { "path": "/api/youtube-analytics", "schedule": "23 * * * *" }
  ],
  "functions": {
    "api/live-ingest.js": { "maxDuration": 300, "includeFiles": "src/utils/liveStats.mjs" },
    "api/portal-sync.js": { "maxDuration": 120 },
    "api/live-chat.js": { "maxDuration": 15, "includeFiles": "src/utils/chatFilter.mjs" },
    "api/stream-manager.js": { "maxDuration": 30, "includeFiles": "{server/stream-manager/assets/BebasNeue-Regular.ttf,src/assets/Logo2.png}" },
    "api/stream-orchestrator.js": { "maxDuration": 60 },
    "api/broadcast-agent.js": { "maxDuration": 15 },
    "api/youtube-analytics.js": { "maxDuration": 300 }
  }
}
