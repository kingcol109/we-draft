{
  "crons": [
    { "path": "/api/live-ingest", "schedule": "* * * * *" },
    { "path": "/api/stream-orchestrator", "schedule": "* * * * *" },
    { "path": "/api/youtube-analytics", "schedule": "23 * * * *" },
    { "path": "/api/recache-mocks", "schedule": "0 12,13 * * 2" },
    { "path": "/api/bot-render-clear", "schedule": "41 * * * *" },
    { "path": "/api/instagram", "schedule": "* * * * *" }
  ],
  "functions": {
    "api/live-ingest.js": { "maxDuration": 300, "includeFiles": "src/utils/liveStats.mjs" },
    "api/portal-sync.js": { "maxDuration": 120, "includeFiles": "{src/utils/portalStars.mjs,src/utils/portalSim/**,src/utils/portalTeams.js,src/utils/highSchoolMatch.js,src/utils/draftSim/draftHistory.json}" },
    "api/live-chat.js": { "maxDuration": 15, "includeFiles": "src/utils/chatFilter.mjs" },
    "api/stream-manager.js": { "maxDuration": 30, "includeFiles": "{server/stream-manager/assets/BebasNeue-Regular.ttf,src/assets/Logo2.png}" },
    "api/stream-orchestrator.js": { "maxDuration": 60 },
    "api/broadcast-agent.js": { "maxDuration": 15 },
    "api/youtube-analytics.js": { "maxDuration": 300 },
    "api/bot-render.js": { "maxDuration": 30 },
    "api/bot-render-clear.js": { "maxDuration": 15 },
    "api/recache-mocks.js": { "maxDuration": 30 },
    "api/mock-og.js": { "maxDuration": 20, "includeFiles": "{server/stream-manager/assets/BebasNeue-Regular.ttf,src/assets/Logo2.png}" },
    "api/first-pick.js": { "maxDuration": 30, "includeFiles": "{server/firstPickImage.mjs,server/stream-manager/assets/BebasNeue-Regular.ttf,src/assets/Logo2.png,src/utils/instagram/*.js,src/utils/*.js}" },
    "api/instagram.js": { "maxDuration": 300 },
    "api/instagram-webhook.js": { "maxDuration": 30 },
    "api/riser-graphic.js": { "maxDuration": 30, "includeFiles": "{server/riserImage.mjs,server/firstPickImage.mjs,server/stream-manager/assets/BebasNeue-Regular.ttf,src/assets/Logo2.png,src/utils/instagram/*.js,src/utils/*.js}" },
    "api/risers/[year]/[file].js": { "maxDuration": 30, "includeFiles": "{api/riser-graphic.js,server/riserImage.mjs,server/firstPickImage.mjs,server/stream-manager/assets/BebasNeue-Regular.ttf,src/assets/Logo2.png,src/utils/instagram/*.js,src/utils/*.js}" },
    "api/cutout.js": { "maxDuration": 30, "includeFiles": "{server/firstPickImage.mjs,src/utils/instagram/*.js,src/utils/*.js}" },
    "api/portal-graphic.js": { "maxDuration": 30, "includeFiles": "{server/portalNewsImage.mjs,server/firstPickImage.mjs,server/stream-manager/assets/BebasNeue-Regular.ttf,src/assets/Logo2.png,src/utils/instagram/*.js,src/utils/*.js}" },
    "api/portal-news/[file].js": { "maxDuration": 30, "includeFiles": "{api/portal-graphic.js,server/portalNewsImage.mjs,server/firstPickImage.mjs,server/stream-manager/assets/BebasNeue-Regular.ttf,src/assets/Logo2.png,src/utils/instagram/*.js,src/utils/*.js}" }
  },
  "redirects": [
    { "source": "/portal/updates", "destination": "/portal/news/updates", "permanent": true }
  ]
}
