{
  "name": "we-draft",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-image": "^3.22.2",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-text-style": "^3.22.3",
    "@tiptap/extension-underline": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "@vercel/analytics": "^1.5.0",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "bad-words": "^4.0.0",
    "canvas-confetti": "^1.9.4",
    "core-js-pure": "^3.45.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^11.0.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-range": "^1.10.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "5.0.1",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "node scripts/generate-sitemap.js && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "sync": "node sync.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "deploy": "npm run generate-sitemap && firebase deploy",
    "broadcast-worker:install": "cd server/broadcast-worker && npm install",
    "broadcast-worker": "node server/broadcast-worker/worker.js",
    "broadcast-worker:test": "node server/broadcast-worker/test.js",
    "broadcast-worker:faults": "node server/broadcast-worker/faults.js",
    "broadcast-worker:ingest-test": "node server/broadcast-worker/ingest-test.js",
    "broadcast-worker:docker-build": "docker build -t we-draft-broadcast-worker server/broadcast-worker",
    "broadcast-worker:docker-test": "node server/broadcast-worker/docker-test.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "react-scripts": {
      "typescript": "$typescript"
    }
  }
}
