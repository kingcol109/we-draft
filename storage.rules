rules_version = '2';
// Cloud Storage for Firebase (we-draft.firebasestorage.app). Closed to every
// client. Its only use is Instagram publishing's staging
// (server/instagram/staging.js, ig-staging/): the server writes the slides
// with the Admin SDK (which these rules don't apply to) and Instagram reads
// them through short-lived signed URLs.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
