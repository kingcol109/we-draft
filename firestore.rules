rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reusable check: does the requesting user's own users/{uid} doc
    // have role == "admin"? Used to gate admin-only writes below. Reading
    // another document from inside a rule (get()) is allowed and is the
    // standard pattern for role-based rules in Firestore. ──
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── Same idea as isAdmin(), but also lets the "writer" role through —
    // AdminArticles.js already gates its own UI on role in ["admin","writer"],
    // this just enforces the same thing server-side for article writes. ──
    function isAdminOrWriter() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "writer"];
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
      match /evaluations/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /reactions/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Collection-group rule for "evaluations", needed for the Admin
    // Panel's Analytics tab, which runs collectionGroup(db, "evaluations")
    // to total evaluations across every player in one query instead of
    // N per-player reads. The individual match block above
    // (players/{playerId}/evaluations/{uid}) only governs direct,
    // path-specific queries and reads — it is NOT consulted for
    // collection-group queries, which is why that query was originally
    // being denied.
    //
    // Unconditional on purpose: a `list`-type collection-group query must
    // be provably allowed for every document the query could return, using
    // only the query's own constraints. A path-dependent condition (e.g.
    // checking whether the doc lives under players/ vs users/) can't be
    // proven for an unfiltered scan across both, so Firestore rejects the
    // whole query rather than partially filtering it — that's what an
    // earlier, conditional version of this rule was doing wrong.
    //
    // This doesn't expose anything new: "evaluations" exists at two paths —
    //   - players/{playerId}/evaluations/{uid}   (canonical, already
    //     `allow read: if true` via the nested match block above)
    //   - users/{uid}/evaluations/{playerId}      (private mirror)
    // PlayerProfile.js's handleSaveEvaluation writes the identical evalData
    // object to both on every save, so the mirror was never actually more
    // sensitive than the already-public canonical copy. ──
    match /{path=**}/evaluations/{evalId} {
      allow read: if true;
    }

    match /schools/{school} { allow read, write: if true; }
    match /nfl/{team} { allow read, write: if true; }
    // TV channel logos — Misc Branding (AdminPanel.js's MiscBrandingSection)
    // manages these; CFB Schedule's "TV Channel" field and GamePage.js's own
    // channel-logo display both read them by Name. Public read like
    // schools/nfl above, but write locked to admin rather than copying
    // their wide-open `if true` — no existing UI relies on a non-admin
    // being able to write this one, so there's no reason to leave it open.
    match /tvChannels/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /draftOrder/{pick} { allow read, write: if true; }
    match /draftOrder2027/{pick} { allow read, write: if true; }
    match /draftOrder2028/{pick} { allow read, write: if true; }
    match /historical/{doc} { allow read, write: if true; }
    match /news/{doc} { allow read, write: if true; }
    match /traits/{doc} { allow read, write: if true; }
    match /config/{doc} { allow read, write: if true; }
    match /playerStats/{doc} { allow read, write: if true; }
    // Page-view counters — written server-side only, by
    // scripts/syncGoogleAnalytics.js (via the admin SDK, which isn't
    // subject to these rules at all); read by AdminPanel.js's Analytics tab.
    // No rule existed for this collection at all before, so that read was
    // being silently denied — the tab worked, it just always showed zero.
    match /analytics/{doc} { allow read: if true; }
    // "Request a Player" form (UserProfile.js) — same story, no rule
    // existed, so every submission was failing. Create-only from the
    // client; nothing in the app currently has an admin review UI for
    // these, but they're gated to admin-read anyway rather than left
    // world-readable, since submissions carry the requester's email.
    match /playerRequests/{doc} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }
    // "Report an Issue" form (UserProfile.js) — same as playerRequests
    // above: no rule existed, submissions were failing.
    match /userReports/{doc} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }
    match /teamPositionRanks/{doc} { allow read, write: if true; }
    match /rosters/{doc} { allow read, write: if true; }
    match /schedule26/{doc} {
      allow read, write: if true;
      // A user's score/text prediction for this game — public read (so
      // aggregate stats and the public-picks list can be computed
      // client-side across everyone's picks, private ones included in the
      // numbers but not shown individually), write restricted to the pick's
      // own owner, same as evaluations/reactions elsewhere.
      match /picks/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // Whether a user has "hyped" this game — same public-read/owner-write
      // shape as picks, existence of the doc is the only signal needed.
      match /hype/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // We-Pick's ranked standings — one doc per leaderboard ("season", or a
    // week label like "Week 1") holding a denormalized `entries` array, so
    // the Standings tab (WePickHub.js) reads one doc instead of scanning
    // every user's picks client-side. Nobody computes/writes this yet
    // (scoring logic is still TBD) — public read now so the page's empty
    // state works for signed-out visitors too, write locked to admin since
    // this will end up populated by a trusted process, never by a user
    // writing their own standing.
    match /wePickStandings2026/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // A user's locked-in Ranked 6 for a given week (WePickHub.js's "Submit
    // for Ranking" button) — same public-read/owner-write shape as
    // schedule26's picks subcollection, since the eventual scoring job
    // needs to read every user's submission for a week in one place.
    match /wePickSubmissions/{week}/entries/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /trends/{doc} { allow read, write: if true; }
    match /rivalries/{doc} { allow read, write: if true; }
    match /videos/{doc} { allow read, write: if true; }
    match /ads/{doc} { allow read, write: if true; }
    match /articles/{doc} {
      allow read: if true;
      allow write: if isAdminOrWriter();
    }
    match /performances/{doc} {
      allow read: if true;
      allow write: if isAdminOrWriter();
    }
    match /users/{uid} {
      allow read: if true;
      // "role" and "verified" are the two fields every trust decision in
      // these rules (and every verified-badge display in the app) is built
      // on — neither is ever written by client code (checked: only set
      // manually, e.g. via the Firebase console), so a blanket "owner can
      // write their own doc" rule would let a user grant themselves admin
      // access or a fake verified badge by writing straight to the SDK,
      // bypassing the app's own UI entirely. create blocks setting either
      // field at all; update requires them to stay exactly as they already
      // are, unless the requester is already an admin.
      allow create: if request.auth != null && request.auth.uid == uid
                    && !("role" in request.resource.data) && !("verified" in request.resource.data);
      // .get(field, default) rather than plain dot access — almost every
      // existing user doc predates this rule and has no `role`/`verified`
      // field at all, and dot-accessing a missing map key errors out the
      // whole expression (which Firestore then denies). .get() falls back
      // to null instead, so someone with no role set can still save their
      // own username: null == null is true, so the "unchanged" check still
      // passes; it only actually blocks a *change* to either field.
      allow update: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && request.resource.data.get("role", null) == resource.data.get("role", null)
                        && request.resource.data.get("verified", null) == resource.data.get("verified", null));
      allow delete: if isAdmin();
      match /evaluations/{playerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /archivedEvaluations/{playerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Players a user follows — own-uid-scoped, same shape as evaluations
      // above. Read/write both gated to the owner; nothing here needs to be
      // publicly readable (no follower counts are shown anywhere).
      match /follows/{playerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Private mirror of a user's own game picks (doc id == the game's
      // schedule26 id), written alongside the canonical
      // schedule26/{gameId}/picks/{uid} doc on every save/remove — same
      // "canonical + private mirror" shape evaluations already uses above.
      // Lets We-Pick's My Picks page (WePickHub.js) list everything a user
      // has picked with one collection read instead of a collection-group
      // query across every game. Owner-only; the canonical copy already
      // covers public reads for aggregation.
      match /picks/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // We-Pick's My Stats tab (WePickHub.js) — the one stat that can't be
      // computed client-side from a user's own picks (Highest Leaderboard
      // Rank needs everyone else's results too). Owner-read only, same as
      // picks above; write locked to admin like wePickStandings2026, since
      // this shouldn't be something a user can just write themselves a
      // flattering number into.
      match /wePickStats/{season} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if isAdmin();
      }
    }
    match /mockDrafts/{draftId} {
      allow read: if resource.data.visibility == 'public'
                  || (request.auth != null && request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.ownerId == request.auth.uid;
    }
    match /myDraftClass/{docId} {
      allow get: if request.auth != null
                 && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
    match /votes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /whiteboards/{docId} {
      allow get: if request.auth != null
                 && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && docId == request.auth.uid + "_" + request.resource.data.draftClass;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
