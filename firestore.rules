rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reusable check: does the requesting user's own users/{uid} doc
    // have role == "admin"? Used to gate admin-only writes below. Reading
    // another document from inside a rule (get()) is allowed and is the
    // standard pattern for role-based rules in Firestore. ──
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── Same idea as isAdmin(), but also lets the "writer" role through —
    // AdminArticles.js already gates its own UI on role in ["admin","writer"],
    // this just enforces the same thing server-side for article writes. ──
    function isAdminOrWriter() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "writer"];
    }

    // ── We-Pick's "locks at kickoff" rule, enforced here rather than just
    // in the UI (GamePage.js's/WePickHub.js's own kickoffMs/isPickable,
    // which only ever disable the form — nothing stopped a direct Firestore
    // SDK call from writing a schedule26/{id}/picks/{uid} doc after kickoff,
    // which is exactly what scripts/gradeWePickWeek.js reads to score the
    // week). KickoffAt is a precomputed UTC Timestamp — set by
    // AdminPanel.js's CFBScheduleSection.handleSave whenever a game's Time
    // is entered, backfilled onto older games by
    // scripts/backfillKickoffAt.js — with the ET-wall-clock/DST conversion
    // already baked in, so this is a plain instant comparison against
    // request.time (the server-trusted request timestamp), no timezone math
    // needed in rules. A game with no KickoffAt (Time was never entered)
    // stays pickable — same "lock via Final only" fallback the client
    // already uses for those — so this only ever tightens behavior for
    // games that actually have a kickoff time. ──
    function gameIsPickable(gameId) {
      let game = get(/databases/$(database)/documents/schedule26/$(gameId)).data;
      return !("KickoffAt" in game) || request.time < game.KickoffAt;
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
      match /evaluations/{uid} {
        allow read: if true;
        // isAdmin() bypass: AdminPanel.js's Dummy Content tab writes an
        // evaluation under a synthetic uid standing in for a real Firebase
        // Auth account (see that file's own DummyEvaluationsSection
        // comment) — request.auth.uid can never equal that synthetic id,
        // so without this the admin-authored write would be denied outright.
        allow write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
      match /reactions/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Collection-group rule for "evaluations", needed for the Admin
    // Panel's Analytics tab, which runs collectionGroup(db, "evaluations")
    // to total evaluations across every player in one query instead of
    // N per-player reads. The individual match block above
    // (players/{playerId}/evaluations/{uid}) only governs direct,
    // path-specific queries and reads — it is NOT consulted for
    // collection-group queries, which is why that query was originally
    // being denied.
    //
    // Unconditional on purpose: a `list`-type collection-group query must
    // be provably allowed for every document the query could return, using
    // only the query's own constraints. A path-dependent condition (e.g.
    // checking whether the doc lives under players/ vs users/) can't be
    // proven for an unfiltered scan across both, so Firestore rejects the
    // whole query rather than partially filtering it — that's what an
    // earlier, conditional version of this rule was doing wrong.
    //
    // This doesn't expose anything new: "evaluations" exists at two paths —
    //   - players/{playerId}/evaluations/{uid}   (canonical, already
    //     `allow read: if true` via the nested match block above)
    //   - users/{uid}/evaluations/{playerId}      (private mirror)
    // PlayerProfile.js's handleSaveEvaluation writes the identical evalData
    // object to both on every save, so the mirror was never actually more
    // sensitive than the already-public canonical copy. ──
    match /{path=**}/evaluations/{evalId} {
      allow read: if true;
    }

    match /schools/{school} { allow read, write: if true; }
    match /nfl/{team} { allow read, write: if true; }
    // Admin-defined named player groups (AdminPanel.js's Player Data
    // section) — each doc owns its own playerIds array, so deleting a group
    // is a single doc delete that never touches a players/{id} doc. Public
    // read (harmless, and simpler than gating a feature with no signed-out
    // UI yet), write locked to admin like tvChannels below.
    match /playerGroups/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // High school recruits (AdminPanel.js's Player Data → Recruits tab) —
    // purely internal admin data with no public page of their own (unlike
    // players/schools), so no public read at all, just isAdmin() both ways.
    // A recruit tagged on a video (AdminPanel.js VideosSection) still
    // surfaces on their committed school's team page for every visitor —
    // that reads the video's own denormalized recruitSchools field
    // (snapshotted at tag time), not this collection, specifically so
    // TeamPage.js never needs public read access here.
    match /recruits/{doc} {
      allow read, write: if isAdmin();
    }
    // High schools — auto-seeded by the Recruits tab's High School field
    // (see RecruitsSection's handleSave) the first time each name is typed,
    // purely to power its own autocomplete. Same admin-only-both-ways
    // treatment as recruits above.
    match /highSchools/{doc} {
      // Public read used to be limited to Ranking == 3 — the only ones
      // HighSchoolTeamPage.js actually builds a team page for here (it
      // queries where("Ranking","==",3), so it only ever sees those
      // regardless of how wide this rule is). Opened up to every doc
      // instead: a separate project reads this same collection (via this
      // same Firebase project) for its own high school branding, and needs
      // every school, not just the 3s we-draft itself has pages for. This
      // doesn't add any new schools to we-draft's own public surface — that
      // Ranking==3 query is what actually gates what shows up here, not
      // this rule.
      allow read: if true;
      allow write: if isAdmin();
    }
    // Named recruit groups — same shape as playerGroups above (own
    // recruitIds array, so deleting a group never touches a recruit doc),
    // but admin-only-both-ways like recruits itself rather than public
    // read, since these organize still-unlaunched prospects.
    match /recruitGroups/{doc} {
      allow read, write: if isAdmin();
    }
    // Content Calendar (AdminPanel.js's ContentCalendarManager) — planned
    // videos/articles/posts, each scoped to a player/recruit/team subject.
    // Purely an internal editorial-planning tool with no public page of its
    // own, same admin-only-both-ways treatment as recruits/recruitGroups
    // above.
    match /contentCalendar/{doc} {
      allow read, write: if isAdmin();
    }
    // TV channel logos — Misc Branding (AdminPanel.js's MiscBrandingSection)
    // manages these; CFB Schedule's "TV Channel" field and GamePage.js's own
    // channel-logo display both read them by Name. Public read like
    // schools/nfl above, but write locked to admin rather than copying
    // their wide-open `if true` — no existing UI relies on a non-admin
    // being able to write this one, so there's no reason to leave it open.
    match /tvChannels/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // State silhouette images — AdminPanel.js's Branding → Teams → High
    // School → States tab. Doc id is the state's own name (fixed 50-state
    // list, nothing to create/delete, just set per state). Same public-
    // read/admin-write shape as tvChannels above.
    match /stateSilhouettes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /draftOrder/{pick} { allow read, write: if true; }
    match /draftOrder2027/{pick} { allow read, write: if true; }
    match /draftOrder2028/{pick} { allow read, write: if true; }
    match /historical/{doc} { allow read, write: if true; }
    match /news/{doc} { allow read, write: if true; }
    match /traits/{doc} { allow read, write: if true; }
    match /config/{doc} { allow read, write: if true; }
    match /playerStats/{doc} { allow read, write: if true; }
    // Page-view counters — written server-side only, by
    // scripts/syncGoogleAnalytics.js (via the admin SDK, which isn't
    // subject to these rules at all); read by AdminPanel.js's Analytics tab.
    // No rule existed for this collection at all before, so that read was
    // being silently denied — the tab worked, it just always showed zero.
    match /analytics/{doc} { allow read: if true; }
    // "Request a Player" form (UserProfile.js), reviewed in AdminPanel.js's
    // Requests section — create-only from the submitting client; update
    // (marking read) and delete (clearing a handled one) are admin-only,
    // since a submitter has no reason to touch their own request again
    // after sending it. Read gated to admin since submissions carry the
    // requester's email.
    match /playerRequests/{doc} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    // "Report an Issue" form (UserProfile.js) — same shape as
    // playerRequests above.
    match /userReports/{doc} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    match /teamPositionRanks/{doc} { allow read, write: if true; }
    match /rosters/{doc} { allow read, write: if true; }
    match /schedule26/{doc} {
      allow read, write: if true;
      // A user's score/text prediction for this game — public read (so
      // aggregate stats and the public-picks list can be computed
      // client-side across everyone's picks, private ones included in the
      // numbers but not shown individually), write restricted to the pick's
      // own owner, same as evaluations/reactions elsewhere.
      match /picks/{uid} {
        allow read: if true;
        // isAdmin() bypass — same reasoning as players/{id}/evaluations/{uid}
        // above: AdminPanel.js's Dummy Content tab writes a prediction under
        // a synthetic uid, which never matches request.auth.uid — and an
        // admin correcting/backfilling a pick isn't the thing gameIsPickable()
        // exists to stop, so it isn't gated by it. The owner's own write path
        // is, though: see gameIsPickable()'s own comment above for why this
        // (not just the client-side kickoffMs/isPickable checks) is what
        // actually stops a pick from being written or edited after kickoff.
        allow write: if (request.auth != null && request.auth.uid == uid && gameIsPickable(doc)) || isAdmin();
      }
      // Whether a user has "hyped" this game — same public-read/owner-write
      // shape as picks, existence of the doc is the only signal needed.
      match /hype/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // Post-game comments (GamePage.js) — unlike picks/hype above, a user
      // can leave more than one, so this is auto-id docs rather than one
      // doc per uid. Public read; create requires the doc's own uid field
      // to match the signed-in requester (not just "any signed-in user can
      // create" — stops someone from posting a comment under a different
      // uid than their own); delete allowed for the comment's author or an
      // admin (moderation). No update at all — a posted comment is either
      // left as-is or deleted, never silently edited after the fact.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
        // Whether a user has liked this comment — same existence-only
        // shape as hype above, just one level deeper. Deleting a comment
        // doesn't cascade-delete these automatically (Firestore never
        // does that for you); GamePage.js's delete handler best-effort
        // cleans up whatever like docs it's actually allowed to (its own,
        // or all of them if admin) before removing the comment itself.
        match /likes/{uid} {
          allow read: if true;
          allow write: if request.auth != null && request.auth.uid == uid;
        }
        // Single level of replies only (a reply can't itself be replied
        // to) — keeps the comment thread flat and easy to follow instead
        // of turning into arbitrarily deep nesting. Same
        // create/delete/no-update shape as comments itself.
        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
          allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
          allow update: if false;
          // Replies are likeable too — same shape as a comment's own
          // likes above, just one level deeper still.
          match /likes/{uid} {
            allow read: if true;
            allow write: if request.auth != null && request.auth.uid == uid;
          }
        }
      }
    }
    // We-Pick's ranked standings — one doc per leaderboard ("season", or a
    // week label like "Week 1") holding a denormalized `entries` array, so
    // the Standings tab (WePickHub.js) reads one doc instead of scanning
    // every user's picks client-side. Populated by
    // scripts/gradeWePickWeek.js (a weekly GitHub Actions cron via the
    // Admin SDK, which bypasses these rules entirely) once every game in a
    // week has gone Final — public read so the page's state works for
    // signed-out visitors too, write locked to admin since this is only
    // ever meant to be populated by that trusted process, never by a user
    // writing their own standing.
    match /wePickStandings2026/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // A user's locked-in Ranked 6 for a given week (WePickHub.js's "Submit
    // for Ranking" button) — same public-read/owner-write shape as
    // schedule26's picks subcollection, since the eventual scoring job
    // needs to read every user's submission for a week in one place.
    match /wePickSubmissions/{week}/entries/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // We-Pick Friends — a pending invitation from one user to another
    // (WePickHub.js's Friends tab). Read restricted to the two people
    // involved (not public — nobody else needs to see who's requesting
    // whom); create requires the sender to be who they claim (fromUid);
    // delete covers both "cancel a request I sent" and "decline one I
    // got", by either party. No update at all — accepting one deletes it
    // and creates a friendships doc instead (see below) rather than
    // flipping a status field, so there's nothing to update.
    match /friendRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.status == "pending";
      allow delete: if request.auth != null
                    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }
    // A confirmed mutual friendship — auto-id doc holding both uids in a
    // `uids` array (not one doc per side under each user's own subcollection,
    // which would need writing into a stranger's namespace to create — no
    // way to do that under owner-scoped rules without a Cloud Function,
    // which this app doesn't use anywhere). Read/delete (unfriend) allowed
    // for either person in the pair. Create is the one rule doing real
    // work: it only allows the doc through if it actually corresponds to a
    // real, still-existing friendRequest sent by the *other* uid to the
    // uid creating this doc — see requestId below — so a friendship can
    // only ever be created by the recipient of a genuine request, never
    // unilaterally declared against someone who never agreed to anything.
    match /friendships/{friendshipId} {
      // Any signed-in user, not just the two people in it — WePickHub.js's
      // Friends tab recommends new friends by mutual-friend count, which
      // means reading a *friend's* other friendships (people two hops away
      // from the requester), not just their own. Usernames are already
      // fully public (users/{uid} below), so this mainly exposes the graph
      // structure itself — who's friends with whom — to anyone signed in,
      // not new personal info beyond that.
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uids.size() == 2
                    && request.auth.uid in request.resource.data.uids
                    && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
                    && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
                    && request.resource.data.uids.hasAll([
                         get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid,
                         get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid
                       ]);
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
      allow update: if false;
    }
    match /trends/{doc} { allow read, write: if true; }
    // Weekly AP-style Top 25 — one doc per week (doc id is the schedule26
    // Week string, e.g. "Week 1"), each holding an ordered Top25 array of
    // {Rank, School}. Week 0 has no doc of its own — everything reading
    // rankings treats "Week 0" as an alias for "Week 1"'s doc (see
    // rankingsWeekKey() in src/utils/rankings.js), so there's exactly one
    // source of truth for both instead of two docs that could drift apart.
    match /rankings/{doc} { allow read, write: if true; }
    match /rivalries/{doc} { allow read, write: if true; }
    match /videos/{doc} { allow read, write: if true; }
    match /ads/{doc} { allow read, write: if true; }
    // Reusable nested rule shape for a likeable, commentable public content
    // doc — same likes/comments/replies structure as schedule26/{doc}'s own
    // hype/comments above (see the detailed reasoning there), just under a
    // path this function doesn't know in advance. Firestore rules aren't
    // inherited by nested collections, so articles/{doc} and
    // performances/{doc} below each need their own copy of this rather
    // than one shared match block — there's no "include" mechanism for
    // partial rule fragments.
    match /articles/{doc} {
      allow read: if true;
      allow write: if isAdminOrWriter();
      // Whether a user has liked this article — same public-read/owner-write,
      // existence-only shape as schedule26/{doc}/hype.
      match /likes/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // Comments (EngagementSection.js) — a user can leave more than one, so
      // auto-id docs rather than one per uid. Public read; create requires
      // the doc's own uid field to match the signed-in requester; delete
      // allowed for the comment's author or an admin. No update — a posted
      // comment is either left as-is or deleted, never silently edited.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
        match /likes/{uid} {
          allow read: if true;
          allow write: if request.auth != null && request.auth.uid == uid;
        }
        // Single level of replies only — same create/delete/no-update shape
        // as comments itself.
        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
          allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
          allow update: if false;
          match /likes/{uid} {
            allow read: if true;
            allow write: if request.auth != null && request.auth.uid == uid;
          }
        }
      }
    }
    match /performances/{doc} {
      allow read: if true;
      allow write: if isAdminOrWriter();
      // Same likes/comments/replies shape as articles/{doc} above.
      match /likes/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
        match /likes/{uid} {
          allow read: if true;
          allow write: if request.auth != null && request.auth.uid == uid;
        }
        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
          allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
          allow update: if false;
          match /likes/{uid} {
            allow read: if true;
            allow write: if request.auth != null && request.auth.uid == uid;
          }
        }
      }
    }
    match /users/{uid} {
      allow read: if true;
      // "role" and "verified" are the two fields every trust decision in
      // these rules (and every verified-badge display in the app) is built
      // on — a regular user never writes either (role is still only ever
      // set by hand, e.g. via the Firebase console; verified is now also
      // settable through AdminPanel.js's Users section, but only by an
      // admin, via the isAdmin() bypass below), so a blanket "owner can
      // write their own doc" rule would let a user grant themselves admin
      // access or a fake verified badge by writing straight to the SDK,
      // bypassing the app's own UI entirely. create blocks setting either
      // field at all; update requires them to stay exactly as they already
      // are, unless the requester is already an admin.
      // isAdmin() bypass added for AdminPanel.js's Dummy Content tab, which
      // creates a companion users/{dummyUid} doc (username only, never
      // role/verified) purely so a dummy evaluation's admin-chosen name
      // resolves through the exact same users/{uid}.username lookup a real
      // evaluation's does — request.auth.uid (the admin's real uid) can
      // never equal the synthetic dummyUid, so the owner-only branch alone
      // would deny this create.
      allow create: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && !("role" in request.resource.data) && !("verified" in request.resource.data));
      // .get(field, default) rather than plain dot access — almost every
      // existing user doc predates this rule and has no `role`/`verified`
      // field at all, and dot-accessing a missing map key errors out the
      // whole expression (which Firestore then denies). .get() falls back
      // to null instead, so someone with no role set can still save their
      // own username: null == null is true, so the "unchanged" check still
      // passes; it only actually blocks a *change* to either field.
      allow update: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && request.resource.data.get("role", null) == resource.data.get("role", null)
                        && request.resource.data.get("verified", null) == resource.data.get("verified", null));
      allow delete: if isAdmin();
      match /evaluations/{playerId} {
        // isAdmin() bypass — same Dummy Content reasoning as
        // players/{id}/evaluations/{uid} above; this is that same write's
        // private mirror.
        allow read, write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
      match /archivedEvaluations/{playerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Players a user follows — own-uid-scoped, same shape as evaluations
      // above. Read/write both gated to the owner; nothing here needs to be
      // publicly readable (no follower counts are shown anywhere).
      match /follows/{playerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Private mirror of a user's own game picks (doc id == the game's
      // schedule26 id), written alongside the canonical
      // schedule26/{gameId}/picks/{uid} doc on every save/remove — same
      // "canonical + private mirror" shape evaluations already uses above.
      // Lets We-Pick's My Picks page (WePickHub.js) list everything a user
      // has picked with one collection read instead of a collection-group
      // query across every game. Owner-only; the canonical copy already
      // covers public reads for aggregation.
      match /picks/{gameId} {
        // isAdmin() bypass — same Dummy Content reasoning as
        // schedule26/{gameId}/picks/{uid} above; this is that same write's
        // private mirror.
        allow read, write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
      // We-Pick's My Stats tab (WePickHub.js) — stats that can't be computed
      // client-side from a user's own picks alone: Highest Leaderboard Rank
      // (needs everyone else's results too) and the four badge counters
      // (sweepCount/snipeCount/topDogCount/immaculateCount), all written by
      // scripts/gradeWePickWeek.js alongside wePickStandings2026 above.
      // Owner-read only, same as picks above; write locked to admin since
      // this shouldn't be something a user can just write themselves a
      // flattering number into.
      match /wePickStats/{season} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if isAdmin();
      }
    }
    match /mockDrafts/{draftId} {
      allow read: if resource.data.visibility == 'public'
                  || (request.auth != null && request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.ownerId == request.auth.uid;
    }
    match /myDraftClass/{docId} {
      allow get: if request.auth != null
                 && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
    match /votes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /whiteboards/{docId} {
      allow get: if request.auth != null
                 && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && docId == request.auth.uid + "_" + request.resource.data.draftClass;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
